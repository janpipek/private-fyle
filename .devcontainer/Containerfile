# Development sandbox image for fyle (same design as arraw's ADR 0044).
#
# Fedora 44 to match the development host. The working tree is bind-mounted at
# run time, so code changes never invalidate the image. Used by
# tools/sandbox.py and by .devcontainer/devcontainer.json.
FROM fedora:44

# One layer: the C toolchain and the native libraries gpui links against
# (xkbcommon, fontconfig/freetype, xcb, wayland), clang for bindgen-based
# crates, just/uv for the Justfile, node/npm for the agent, fonts so gpui has
# something to render, and the Vulkan/Mesa runtime used only with --gui.
# Codex needs ps (procps-ng) to track its background app-server process.
# poppler-utils and ffmpeg-free are the optional runtime programs behind the
# PDF and media previews.
RUN dnf install -y --setopt=install_weak_deps=False \
        gcc gcc-c++ make cmake git pkgconf-pkg-config procps-ng \
        libxkbcommon-devel libxkbcommon-x11-devel fontconfig-devel freetype-devel \
        libxcb-devel wayland-devel openssl-devel \
        clang clang-devel \
        just uv nodejs npm \
        dejavu-sans-fonts dejavu-sans-mono-fonts \
        vulkan-loader mesa-vulkan-drivers mesa-dri-drivers \
        xdg-utils xorg-x11-server-Xvfb xdotool ImageMagick \
        poppler-utils ffmpeg-free \
    && dnf clean all

# Rust via rustup, so the toolchain tracks upstream stable like the host's.
# RUSTUP_HOME is read-only at run time; CARGO_HOME is world-writable because the
# sandbox runs as the host UID (--userns=keep-id) and cargo writes its registry
# cache there.
ARG RUST_TOOLCHAIN=stable
ENV RUSTUP_HOME=/opt/rustup \
    CARGO_HOME=/opt/cargo \
    PATH=/opt/cargo/bin:$PATH
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path --profile minimal \
        --default-toolchain "$RUST_TOOLCHAIN" --component rustfmt,clippy \
    && chmod -R a+rwX "$CARGO_HOME"

# Coding agents, global so they are on PATH for any runtime user.
RUN npm install -g @anthropic-ai/claude-code @openai/codex \
    @earendil-works/pi-coding-agent
# RUN claude plugin install mattpocock-skills@claude-plugins-official

# The bind-mounted repo has host ownership; without this git refuses to operate
# on it ("dubious ownership"). System-wide so it holds for every user/IDE.
RUN git config --system --add safe.directory '*'

# A world-writable HOME that works whatever UID we run as.
RUN install -d -m 0777 /home/dev /home/dev/.cache /home/dev/.npm /home/dev/.codex \
    /home/dev/.pi
ENV HOME=/home/dev \
    XDG_CACHE_HOME=/home/dev/.cache \
    npm_config_cache=/home/dev/.npm

# Seed new Codex volumes in the runtime user's home. Existing volumes are
# initialized by the entrypoint, since mounting one hides the image contents.
RUN codex plugin marketplace add mattpocock/skills \
    && codex plugin add mattpocock-skills@mattpocock \
    && chmod -R a+rwX /home/dev/.codex
COPY codex-entrypoint.sh /usr/local/bin/codex-entrypoint
RUN chmod +x /usr/local/bin/codex-entrypoint
ENTRYPOINT ["/usr/local/bin/codex-entrypoint"]

# Headless by default; tools/sandbox.py --gui adds the Wayland/GPU wiring.
CMD ["bash"]
